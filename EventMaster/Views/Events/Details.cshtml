@model EventMaster.Data.Models.Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="ts-banner-wrapper">
    <img src="@Model.ImageUrl" class="ts-banner-img" alt="@Model.Title">
    <div class="ts-banner-overlay">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <span class="badge bg-danger mb-3 px-3 py-2 text-uppercase fw-bold">@Model.Category?.Name</span>
                    <h1 class="ts-banner-title mb-0">@Model.Title</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container ts-overlap-container pb-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="ts-info-box mb-4">
                <h4 class="fw-bold mb-4 border-bottom pb-2 text-uppercase">Относно</h4>
                <div class="text-muted fs-5" style="line-height: 1.8;">
                    @Model.Description
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="ts-info-box">
                <div class="mb-4 text-center">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">DATE</label>
                    <p class="fs-4 fw-black mb-0" style="font-weight: 900;">@Model.StartDate.ToString("dd MMMM yyyy")</p>
                    <p class="text-danger fw-bold fs-5">@Model.StartDate.ToString("HH:mm") h.</p>
                </div>

                <div class="mb-4 text-center border-top pt-4">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">VENUE</label>
                    <p class="fs-5 fw-bold mb-0">@Model.Venue?.Name</p>
                    <small class="text-muted">@Model.Venue?.Address</small>
                </div>

                <div class="mb-4 border-top pt-4">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-1">Availability</label>
                    <div class="progress mt-2" style="height: 12px;">
                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" style="width: 85%"></div>
                    </div>
                    <small class="text-danger fw-bold">Последни билети!</small>
                </div>

                <hr />
                <button class="btn btn-ticket btn-lg w-100 py-3 text-uppercase fw-black mb-3" style="font-weight: 900; font-size: 1.2rem;">
                    Купи Билет
                </button>

                @if (User.IsInRole("Administrator"))
                {
                    <div class="mt-2 border-top pt-3">
                        <label class="text-muted small text-uppercase fw-bold d-block mb-2 text-center">Админ Панел</label>
                        <a asp-area="Admin" asp-controller="Events" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 mb-2 fw-bold">
                            <i class="bi bi-pencil"></i> Редактирай
                        </a>
                        <a asp-area="Admin" asp-controller="Events" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger w-100 fw-bold">
                            <i class="bi bi-trash"></i> Изтрий
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>