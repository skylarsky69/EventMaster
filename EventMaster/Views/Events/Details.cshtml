@model EventMaster.Data.Models.Event

@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-5 pt-4 pb-5">
    <div class="row bg-white shadow-lg rounded-4 overflow-hidden">

        <div class="col-lg-6 p-0 position-relative">
            <img src="@Model.ImageUrl" class="img-fluid w-100 h-100" style="object-fit: cover; min-height: 500px;" alt="@Model.Title">
            <div class="position-absolute top-0 start-0 m-4">
                <span class="badge bg-danger fs-5 shadow">@Model.Category?.Name</span>
            </div>

            <button id="favoriteBtn" class="btn btn-light position-absolute top-0 end-0 m-4 rounded-circle shadow" style="width: 50px; height: 50px; padding: 0;" onclick="toggleFavorite(@Model.Id)">
                <i id="favoriteIcon" class="bi bi-heart fs-4 text-danger"></i>
            </button>
        </div>

        <div class="col-lg-6 p-5 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h1 class="fw-black text-uppercase text-dark display-5 mb-0">@Model.Title</h1>
            </div>

            <div class="d-flex align-items-center mb-4 text-muted">
                <i class="bi bi-calendar-check fs-4 me-3 text-danger"></i>
                <span class="fs-5 fw-bold">@Model.StartDate.ToString("dd MMMM yyyy, HH:mm")</span>
            </div>

            <div class="d-flex align-items-center mb-4 text-muted">
                <i class="bi bi-geo-alt-fill fs-4 me-3 text-danger"></i>
                <span class="fs-5 fw-bold">@Model.Venue?.Name - @Model.Venue?.Address</span>
            </div>

            <hr class="mb-4">

            <h5 class="fw-bold mb-3 text-uppercase" style="letter-spacing: 1px;">За събитието:</h5>
            <p class="text-muted mb-5" style="line-height: 1.8; font-size: 1.1rem;">@Model.Description</p>

            <div class="mt-auto row g-3 mb-4">
                <div class="col-md-6">
                    <div class="bg-light p-3 rounded-3 text-center border">
                        <span class="d-block text-muted small text-uppercase fw-bold">Цена на билет</span>
                        <span class="fs-3 fw-black text-danger">25.00 &euro;</span>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-stretch">
                    <a asp-controller="Events" asp-action="Book" asp-route-id="@Model.Id" class="btn btn-danger w-100 fw-bold fs-5 text-uppercase rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="background-color: #ff0055; border: none;">
                        КУПИ БИЛЕТ
                    </a>
                </div>
            </div>

            @if (User.IsInRole("Administrator"))
            {
                <div class="bg-light p-3 rounded-4 border border-warning border-2 d-flex gap-2">
                    <a asp-area="Admin" asp-controller="Events" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning flex-grow-1 fw-bold text-uppercase">
                        <i class="bi bi-pencil-square me-1"></i> Редактирай
                    </a>
                    <a asp-area="Admin" asp-controller="Events" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-grow-1 fw-bold text-uppercase">
                        <i class="bi bi-trash me-1"></i> Изтрий
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-black mb-0 text-uppercase"><i class="bi bi-map text-danger me-2"></i> Локация и Маршрут</h3>
                    <button id="findMeBtn" class="btn btn-outline-danger fw-bold rounded-pill px-4" onclick="findMyLocation()">
                        <i class="bi bi-geo text-danger me-1"></i> Къде съм аз?
                    </button>
                </div>

                <div id="map" class="rounded-3 bg-light border" style="height: 450px; width: 100%; z-index: 1;">
                    <div class="d-flex justify-content-center align-items-center h-100">
                        <span class="text-muted">Зареждане на интерактивна карта...</span>
                    </div>
                </div>
                <p id="geoError" class="text-danger mt-2 fw-bold d-none"></p>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@section Scripts {
    <script>
        const eventId = @Model.Id;

        document.addEventListener("DOMContentLoaded", function() {
            checkIfFavorite();
            initMap();
        });

        // LOCAL STORAGE ЛОГИКА
        function checkIfFavorite() {
            let favorites = JSON.parse(localStorage.getItem('eventFavorites')) || [];
            let icon = document.getElementById('favoriteIcon');
            if (favorites.includes(eventId)) {
                icon.classList.remove('bi-heart');
                icon.classList.add('bi-heart-fill');
            }
        }

        function toggleFavorite(id) {
            let favorites = JSON.parse(localStorage.getItem('eventFavorites')) || [];
            let icon = document.getElementById('favoriteIcon');
            if (favorites.includes(id)) {
                favorites = favorites.filter(favId => favId !== id);
                icon.classList.replace('bi-heart-fill', 'bi-heart');
            } else {
                favorites.push(id);
                icon.classList.replace('bi-heart', 'bi-heart-fill');
            }
            localStorage.setItem('eventFavorites', JSON.stringify(favorites));
        }

        // GEOLOCATION ЛОГИКА
        let map;
        function initMap() {
            map = L.map('map').setView([42.6977, 23.3219], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
            L.marker([42.6977, 23.3219]).addTo(map)
                .bindPopup("<b>@Model.Venue?.Name</b>").openPopup();
        }

        function findMyLocation() {
            let btn = document.getElementById('findMeBtn');
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    let userLat = position.coords.latitude;
                    let userLng = position.coords.longitude;
                    L.marker([userLat, userLng]).addTo(map).bindPopup("Вие сте тук").openPopup();
                    map.flyTo([userLat, userLng], 14);
                });
            }
        }
    </script>
}