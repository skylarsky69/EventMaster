@model EventMaster.Data.Models.Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/600x400?text=Event+Image" : Model.ImageUrl)"
                 class="img-fluid rounded shadow" alt="@Model.Title" style="width: 100%; object-fit: cover; max-height: 400px;">
        </div>

        <div class="col-md-6">
            <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>
            <div class="d-flex align-items-center mb-3">
                <span class="badge bg-secondary me-2 fs-6">@Model.Category.Name</span>
                <span class="text-muted"><i class="bi bi-calendar3"></i> @Model.StartDate.ToString("dd MMMM yyyy, HH:mm ч.")</span>
            </div>

            <h4 class="mt-4">Място на провеждане:</h4>
            <p class="fs-5">
                📍 <strong>@Model.Venue.Name</strong><br />
                <small class="text-muted">@Model.Venue.Address</small>
            </p>

            <h4 class="mt-4">За събитието:</h4>
            <p class="lead" style="white-space: pre-line;">@Model.Description</p>

            <hr class="my-4">

            <div class="d-grid gap-2 d-md-block">
                <button class="btn btn-success btn-lg px-5" type="button">Купи билет</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 ms-2">Назад към всички</a>
            </div>
        </div>
    </div>
</div>