@model IEnumerable<EventMaster.Data.Models.Event>

@{
    ViewData["Title"] = "Всички събития";
}

<h2 class="text-center mt-4 mb-4">Предстоящи събития</h2>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center mt-5">
            <h4 class="text-muted">В момента няма добавени събития.</h4>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">

                    <div class="card h-100 shadow-sm border-0">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <span class="badge bg-primary rounded-pill">@item.Category?.Name</span>
                                <small class="text-muted"><i class="bi bi-calendar3"></i> @item.StartDate.ToString("dd.MM.yyyy")</small>
                            </div>
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="card-text text-muted small">@item.Description.Substring(0, Math.Min(item.Description.Length, 100))...</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 rounded-pill">Виж детайли</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>