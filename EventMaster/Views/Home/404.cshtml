@{
    ViewData["Title"] = "Страницата не е намерена";
}

<div class="container text-center mt-5 pt-5 pb-5">
    <div class="mb-4">
        <h1 class="display-1 fw-black text-danger" style="font-size: 10rem; font-weight: 900; text-shadow: 0 0 30px rgba(255,0,85,0.6);">404</h1>
    </div>

    <h2 class="text-dark fw-bold text-uppercase mb-3">Опа! Изглежда сте се изгубили...</h2>

    <p class="text-muted fs-5 mb-5 mx-auto" style="max-width: 600px;">
        Събитието, залата или страницата, която търсите, е разпродадена, изтрита или никога не е съществувала. Нека ви върнем обратно на сцената!
    </p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-ticket btn-lg px-5 py-3 text-uppercase fw-bold shadow-lg">
        <i class="bi bi-house-door me-2"></i> Обратно към Началото
    </a>
</div>