@{
    ViewData["Title"] = "Страницата не е намерена";
}
<div class="container text-center py-5 mt-5">
    <h1 class="display-1 fw-bold text-danger">404</h1>
    <h2 class="mb-4">Опа! Тази страница не съществува.</h2>
    <p class="fs-5 text-muted mb-5">Изглежда сте последвали счупен линк или страницата е била премахната.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
        <i class="bi bi-house-door me-2"></i>Към началната страница
    </a>
</div>