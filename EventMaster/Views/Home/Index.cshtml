@{
    ViewData["Title"] = "Начало";
}

<section class="hero-section text-center shadow-lg">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Открий следващото си приключение</h1>
        <p class="lead mb-5 fs-4">Най-добрите концерти, фестивали и театрални постановки на едно място.</p>
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a asp-controller="Events" asp-action="Index" class="btn btn-primary btn-lg px-5 gap-3">Разгледай събитията</a>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-light btn-lg px-5">Свържи се с нас</a>
        </div>
    </div>
</section>

<div class="container my-5 py-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="p-4 card h-100 shadow-sm">
                <div class="fs-1 text-primary mb-3"><i class="bi bi-lightning-charge"></i></div>
                <h3 class="fw-bold">Бърза покупка</h3>
                <p class="text-muted">Вземи своя билет само с няколко клика, без излишно чакане на опашки.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 card h-100 shadow-sm border-primary" style="border-width: 2px;">
                <div class="fs-1 text-primary mb-3"><i class="bi bi-shield-check"></i></div>
                <h3 class="fw-bold">Сигурност</h3>
                <p class="text-muted">Гарантирана защита на твоите данни и 100% валидни билети за всяко събитие.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 card h-100 shadow-sm">
                <div class="fs-1 text-primary mb-3"><i class="bi bi-geo-alt"></i></div>
                <h3 class="fw-bold">Топ локации</h3>
                <p class="text-muted">Работим с най-големите зали и театри в страната, за да ти осигурим най-доброто.</p>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="bg-dark text-white rounded-5 p-5 text-center shadow">
        <h2 class="fw-bold mb-3">Организираш събитие?</h2>
        <p class="mb-4 opacity-75">Стани част от нашето семейство и достигни до хиляди потребители всеки ден.</p>
        <a asp-controller="Contact" asp-action="Index" class="btn btn-light rounded-pill px-4">Научи повече</a>
    </div>
</div>