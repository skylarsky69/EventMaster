@{
    ViewData["Title"] = "Добре дошли";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-lg" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80'); background-size: cover; background-position: center;">
    <div class="container-fluid py-5 text-center">
        <h1 class="display-3 fw-bold">Открий следващото си приключение</h1>
        <p class="fs-4">Най-добрите концерти, фестивали и културни събития на едно място.</p>
        <div class="mt-4">
            <a asp-controller="Events" asp-action="Index" class="btn btn-primary btn-lg px-5 shadow">Разгледай събития</a>
            @if (!(User.Identity?.IsAuthenticated ?? false))
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg px-5 ms-2">Регистрирай се</a>
            }
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 py-5 row-cols-1 row-cols-lg-3 text-center">
        <div class="feature col">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center fs-1 mb-3 text-primary">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <h3 class="fs-2 text-body-emphasis">Лесна покупка</h3>
            <p>Купи билет само с два клика. Всички твои билети се пазят в профила ти за бърз достъп.</p>
        </div>
        <div class="feature col">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center fs-1 mb-3 text-success">
                <i class="bi bi-calendar-check"></i>
            </div>
            <h3 class="fs-2 text-body-emphasis">Разнообразие</h3>
            <p>От рок концерти до театрални постановки – имаме събития за всеки вкус и възраст.</p>
        </div>
        <div class="feature col">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center fs-1 mb-3 text-danger">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h3 class="fs-2 text-body-emphasis">Сигурност</h3>
            <p>Гарантирана защита на твоите данни и сигурни транзакции при всяка поръчка.</p>
        </div>
    </div>
</div>

<hr class="my-5" />

<div class="container mb-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold mb-4">Често задавани въпроси</h2>
            <div class="accordion" id="faqAccordion">
                <div class="accordion-item shadow-sm mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            Как ще получа билета си?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            След покупка, билетът се генерира автоматично и е достъпен в секция <strong>"Моите билети"</strong> в профила ти.
                        </div>
                    </div>
                </div>
                <div class="accordion-item shadow-sm mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            Мога ли да върна билет?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Връщането на билети зависи от условията на организатора. Свържете се с нас чрез контактната форма за съдействие.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 text-center">
            <img src="https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60" class="img-fluid rounded shadow-lg" alt="Organize Event" />
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        </div>
    </div>
</div>