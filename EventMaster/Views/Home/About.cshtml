@{
    ViewData["Title"] = "За нас";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Нашата мисия в <span class="text-primary">EventMaster</span></h1>
        <p class="lead text-muted">Свързваме хората с незабравими преживявания от 2024 г. насам.</p>
    </div>

    <div class="row g-4 text-center mb-5">
        <div class="col-md-4">
            <div class="p-4 border rounded-3 shadow-sm bg-light">
                <h2 class="fw-bold text-primary">500+</h2>
                <p class="mb-0">Проведени събития</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border rounded-3 shadow-sm bg-light">
                <h2 class="fw-bold text-success">10k+</h2>
                <p class="mb-0">Щастливи клиенти</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border rounded-3 shadow-sm bg-light">
                <h2 class="fw-bold text-danger">50+</h2>
                <p class="mb-0">Партньори</p>
            </div>
        </div>
    </div>

    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3">Кои сме ние?</h2>
            <p class="text-secondary">
                EventMaster е водеща платформа за продажба на билети и управление на събития в България.
                Ние вярваме, че културата и забавленията трябва да бъдат достъпни за всеки, само с няколко клика.
            </p>
            <p class="text-secondary">
                Нашата система е изградена с най-модерните технологии на <strong>ASP.NET Core</strong>,
                гарантирайки сигурност, бързина и безупречно потребителско изживяване.
            </p>
            <ul class="list-unstyled mt-3">
                <li><i class="bi bi-check-circle-fill text-primary me-2"></i> 100% сигурни плащания</li>
                <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Денонощна поддръжка</li>
                <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Лесен достъп през мобилни устройства</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80"
                 class="img-fluid rounded-4 shadow-lg" alt="Нашият екип">
        </div>
    </div>
</div>