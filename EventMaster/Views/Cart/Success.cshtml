@{
    ViewData["Title"] = "Успешно плащане";
}

<div class="container mt-5 pt-5 pb-5 text-center">
    <div class="card bg-dark border-success shadow-lg p-5 mx-auto rounded-4" style="max-width: 600px;">
        <div class="mb-4">
            <i class="bi bi-patch-check-fill text-success" style="font-size: 6rem; text-shadow: 0 0 30px rgba(25, 135, 84, 0.6);"></i>
        </div>

        <h2 class="text-white fw-black mb-3 text-uppercase">Плащането е успешно!</h2>

        <p class="text-muted fs-5 mb-5 mx-auto" style="line-height: 1.6;">
            Благодарим ти за покупката! Билетите бяха генерирани успешно и копие от тях е изпратено на твоя имейл адрес. Очакваме те пред сцената!
        </p>

        <a asp-controller="Events" asp-action="Index" class="btn btn-ticket btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg w-100">
            <i class="bi bi-stars me-2"></i> Обратно към всички събития
        </a>
    </div>
</div>