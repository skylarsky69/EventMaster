@{
    ViewData["Title"] = "Моите Билети";
}

<div class="container mt-5 pt-4 pb-5">
    <h2 class="fw-black text-dark mb-5 text-uppercase border-bottom border-secondary pb-3">
        <i class="bi bi-ticket-detailed text-danger me-2"></i> Дигитален Портфейл
    </h2>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (ViewBag.Event != null)
            {
                <div id="pdf-container" style="padding: 20px; background-color: #ffffff; border-radius: 15px;" class="mb-4 shadow-sm border">

                    <div id="ticket-content" class="card bg-dark text-white border-0 shadow-lg rounded-4 overflow-hidden position-relative m-0">
                        <div class="row g-0">

                            <div class="col-md-8 p-4 border-end border-secondary border-2 border-dashed" style="border-right-style: dashed !important;">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span class="badge bg-danger text-uppercase px-3 py-2">@(ViewBag.Event.Category?.Name ?? "Събитие")</span>
                                    <span class="text-muted fw-bold"><i class="bi bi-calendar-event me-1"></i> @ViewBag.Event.StartDate.ToString("dd MMM yyyy")</span>
                                </div>

                                <h3 class="fw-black text-uppercase mb-1" style="letter-spacing: 1px;">@ViewBag.Event.Title</h3>
                                <p class="text-muted mb-4"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @(ViewBag.Event.Venue?.Name ?? "Неизвестна локация")</p>

                                <div class="row bg-black p-3 rounded-3 text-center mx-0 mt-auto">
                                    <div class="col-6 border-end border-secondary">
                                        <span class="d-block text-muted small text-uppercase fw-bold">Сектор</span>
                                        <span class="fs-5 fw-bold text-white">ОСНОВЕН</span>
                                    </div>
                                    <div class="col-6">
                                        <span class="d-block text-muted small text-uppercase fw-bold">Твоите Места</span>
                                        <span class="fs-5 fw-bold text-danger">@ViewBag.MySeats</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 d-flex flex-column justify-content-center align-items-center p-4 bg-black">
                                <p class="text-muted text-uppercase small fw-bold mb-2">СКАНИРАЙ НА ВХОДА</p>

                                <div id="qrcode-container" class="bg-white p-2 rounded-3 mb-2" style="width: 136px; height: 136px;"></div>

                                <p class="text-muted mt-2 mb-0" style="font-family: monospace; font-size: 1.1rem;">#TCKT-@ViewBag.Event.Id</p>
                            </div>
                        </div>

                        <div class="position-absolute" style="background-color: #ffffff; width: 30px; height: 30px; border-radius: 50%; top: -15px; right: 33.333%; transform: translateX(50%);"></div>
                        <div class="position-absolute" style="background-color: #ffffff; width: 30px; height: 30px; border-radius: 50%; bottom: -15px; right: 33.333%; transform: translateX(50%);"></div>
                    </div>

                </div>

                <button onclick="downloadPDF()" class="btn btn-danger btn-lg w-100 fw-bold rounded-pill shadow-sm text-uppercase">
                    <i class="bi bi-download me-2"></i> Изтегли билета като PDF
                </button>
            }
            else
            {
                <div class="text-center mt-5 py-5 bg-white border rounded-4 shadow-sm">
                    <i class="bi bi-wallet2 text-muted mb-3 d-block" style="font-size: 4rem;"></i>
                    <h3 class="fw-bold text-dark">Твоят портфейл е празен</h3>
                    <p class="text-muted fs-5">Все още нямаш закупени билети за предстоящи събития.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-danger mt-4 text-white fw-bold px-5 py-2 rounded-pill shadow">Разгледай Събитията</a>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const qrContainer = document.getElementById("qrcode-container");
            if (qrContainer) {
                new QRCode(qrContainer, {
                    text: "Ticket-@(ViewBag.Event?.Id)",
                    width: 120,
                    height: 120,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.H
                });
            }
        });

        function downloadPDF() {
            
            const pdfContainer = document.getElementById('pdf-container');

            const opt = {
                margin:       0, 
                filename:     'EventMaster-Ticket.pdf',
                image:        { type: 'jpeg', quality: 1 },
                html2canvas:  {
                    scale: 2,
                    useCORS: true,
                    scrollY: 0, 
                    scrollX: 0
                },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };

            pdfContainer.classList.remove('border', 'shadow-sm');

            html2pdf().set(opt).from(pdfContainer).save().then(() => {
                pdfContainer.classList.add('border', 'shadow-sm');
            });
        }
    </script>
}