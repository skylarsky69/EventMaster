@{
    ViewData["Title"] = "Моите Билети";
}

<div class="container mt-5 pt-4 pb-5">
    <h2 class="fw-black text-dark mb-5 text-uppercase border-bottom border-secondary pb-3">
        <i class="bi bi-ticket-detailed text-danger me-2"></i> Дигитален Портфейл
    </h2>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card bg-dark text-white border-0 shadow-lg rounded-4 overflow-hidden mb-4 position-relative">
                <div class="row g-0">

                    <div class="col-md-8 p-4 border-end border-secondary border-2 border-dashed" style="border-right-style: dashed !important;">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-danger text-uppercase px-3 py-2">Спорт / Гейминг</span>
                            <span class="text-muted fw-bold"><i class="bi bi-calendar-event me-1"></i> 25 Май 2026</span>
                        </div>

                        <h3 class="fw-black text-uppercase mb-1" style="letter-spacing: 1px;">E-SPORTS BALKAN ARENA</h3>
                        <p class="text-muted mb-4"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Арена София</p>

                        <div class="row bg-black p-3 rounded-3 text-center mx-0 mt-auto">
                            <div class="col-4 border-end border-secondary">
                                <span class="d-block text-muted small text-uppercase fw-bold">Сектор</span>
                                <span class="fs-5 fw-bold">VIP</span>
                            </div>
                            <div class="col-4 border-end border-secondary">
                                <span class="d-block text-muted small text-uppercase fw-bold">Ред</span>
                                <span class="fs-5 fw-bold">1</span>
                            </div>
                            <div class="col-4">
                                <span class="d-block text-muted small text-uppercase fw-bold">Място</span>
                                <span class="fs-5 fw-bold">2, 3</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex flex-column justify-content-center align-items-center p-4 bg-black">
                        <p class="text-muted text-uppercase small fw-bold mb-2">СКАНИРАЙ НА ВХОДА</p>
                        <i class="bi bi-qr-code text-white bg-dark p-3 rounded-3" style="font-size: 6rem;"></i>
                        <p class="text-muted mt-3 mb-0" style="font-family: monospace; font-size: 1.1rem;">#TCKT-849201X</p>

                        <button class="btn btn-outline-light btn-sm mt-3 w-100 fw-bold rounded-pill">
                            <i class="bi bi-download me-1"></i> Изтегли PDF
                        </button>
                    </div>
                </div>

                <div class="position-absolute bg-body" style="width: 30px; height: 30px; border-radius: 50%; top: -15px; right: 33.333%; transform: translateX(50%);"></div>
                <div class="position-absolute bg-body" style="width: 30px; height: 30px; border-radius: 50%; bottom: -15px; right: 33.333%; transform: translateX(50%);"></div>
            </div>

            <div class="text-center mt-5">
                <p class="text-muted"><i class="bi bi-info-circle me-1"></i> Показват се само предстоящи събития.</p>
            </div>

        </div>
    </div>
</div>