@model EventMaster.Data.Models.Venue

@{
    ViewData["Title"] = "Детайли за място";
}

<div class="container mt-5 pt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-black text-white text-center py-4 border-bottom border-secondary">
                    <i class="bi bi-geo-alt-fill text-danger" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mb-0 mt-2 text-uppercase">Детайли за Място</h2>
                </div>

                <div class="card-body p-5 bg-dark text-white">

                    <div class="bg-black p-4 rounded-3 mb-4 border border-secondary shadow-sm">
                        <div class="row align-items-center mb-3">
                            <div class="col-sm-4 text-muted text-uppercase fw-bold small">Име на залата</div>
                            <div class="col-sm-8 fs-4 fw-black text-white">@Model.Name</div>
                        </div>
                        <hr class="border-secondary my-2" />

                        <div class="row align-items-center mb-3 mt-3">
                            <div class="col-sm-4 text-muted text-uppercase fw-bold small">Точен Адрес</div>
                            <div class="col-sm-8 fs-5 text-white">
                                <i class="bi bi-map me-1 text-danger"></i> @Model.Address
                            </div>
                        </div>
                        <hr class="border-secondary my-2" />

                        <div class="row align-items-center mt-3">
                            <div class="col-sm-4 text-muted text-uppercase fw-bold small">Капацитет</div>
                            <div class="col-sm-8 text-danger fw-bold fs-4">
                                <i class="bi bi-people-fill me-1"></i> @Model.Capacity <span class="fs-6 text-muted">места</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-5 border-top border-secondary pt-4">
                        <a asp-action="Index" class="btn btn-outline-light px-4 py-2 fw-bold text-uppercase rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i> Обратно към списъка
                        </a>

                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-ticket px-5 py-2 fw-bold text-uppercase rounded-pill shadow-lg text-white">
                            <i class="bi bi-pencil-square me-2"></i> Редактирай
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>