@model IEnumerable<EventMaster.Data.Models.Venue>

@{
    ViewData["Title"] = "Места и Зали";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase"><i class="bi bi-geo-alt-fill text-danger"></i> Управление на Места</h2>
        <a asp-action="Create" class="btn btn-ticket fw-bold"><i class="bi bi-plus-lg"></i> Добави ново място</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 px-4">Име на зала/град</th>
                        <th class="py-3 px-4">Адрес</th>
                        <th class="py-3 px-4 text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold px-4">@item.Name</td>
                            <td class="align-middle px-4 text-muted">@item.Address</td>
                            <td class="text-end align-middle px-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-pencil"></i> Редакция</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3"><i class="bi bi-info-circle"></i> Детайли</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-trash"></i> Изтрий</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>