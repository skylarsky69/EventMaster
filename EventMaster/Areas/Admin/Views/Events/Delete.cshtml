@model EventMaster.Data.Models.Event

@{
    ViewData["Title"] = "Изтрий събитие";
}

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">⚠️ Потвърждение за изтриване</h3>
        </div>
        <div class="card-body">
            <p class="lead">Сигурни ли сте, че искате да изтриете това събитие? Това действие е <strong>необратимо</strong>.</p>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Заглавие:</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Дата:</dt>
                <dd class="col-sm-9">@Model.StartDate.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3">Място:</dt>
                <dd class="col-sm-9">@Model.Venue.Name</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4">Да, изтрий го</button>
                <a asp-area="" asp-controller="Events" asp-action="Index" class="btn btn-secondary px-4">Отказ</a>
            </form>
        </div>
    </div>
</div>