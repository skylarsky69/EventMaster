@model IEnumerable<EventMaster.Data.Models.ContactMessage>

@{
    ViewData["Title"] = "Входящи съобщения";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-envelope-fill text-primary"></i> Входящи съобщения</h2>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>От</th>
                    <th>Тема</th>
                    <th>Съобщение</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="white-space: nowrap;">@item.SentOn.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <strong>@item.Name</strong><br />
                            <small class="text-muted">@item.Email</small>
                        </td>
                        <td>@item.Subject</td>
                        <td>
                            <div class="text-truncate" style="max-width: 300px;" title="@item.Message">
                                @item.Message
                            </div>
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Сигурни ли сте?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Няма намерени съобщения.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>