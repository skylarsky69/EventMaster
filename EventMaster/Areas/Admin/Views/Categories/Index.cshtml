@model IEnumerable<EventMaster.Data.Models.Category>


@{
    ViewData["Title"] = "Управление на категории";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <h2 class="text-light mb-0">
            <i class="bi bi-folder-fill" style="color: #e50914;"></i> Управление на категории
        </h2>
        <a asp-action="Create" class="btn btn-danger px-4 rounded-pill fw-bold shadow-sm">
            + Добави нова
        </a>
    </div>

    <div class="card bg-dark text-white shadow-lg" style="border-top: 3px solid #e50914; border-radius: 10px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-borderless mb-0" style="border-radius: 10px; overflow: hidden;">
                    <thead class="border-bottom border-secondary" style="background-color: #1a1a1a;">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase text-muted fs-6">Име на категорията</th>
                            <th class="text-end pe-4 py-3 text-uppercase text-muted fs-6">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle border-bottom border-secondary border-opacity-25">
                                <td class="ps-4 py-3 fw-semibold fs-5">
                                    @item.Name
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 me-2 fw-bold">
                                        Редактирай
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                        Изтрий
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>