@model IEnumerable<EventMaster.Data.Models.Category>

<div class="container mt-4">
    <h2>📂 Управление на категории</h2>
    <p><a asp-action="Create" class="btn btn-success">➕ Добави нова</a></p>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Име на категорията</th>
                <th class="text-center">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактирай</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>