@model EventMaster.Data.Models.Category

@{
    ViewData["Title"] = "Добави Категория";
}

<div class="container mt-5 pt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-black text-white text-center py-4 border-bottom border-secondary">
                    <i class="bi bi-tags-fill text-danger" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mb-0 mt-2 text-uppercase">Нова Категория</h2>
                </div>

                <div class="card-body p-5 bg-dark text-white">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label text-muted text-uppercase fw-bold small">Име на категорията</label>
                            <input asp-for="Name" class="form-control bg-black text-white border-secondary py-2" placeholder="напр. Концерт, Театър, Спорт..." />
                            <span asp-validation-for="Name" class="text-danger fw-bold"></span>
                        </div>

                        <button type="submit" class="btn btn-ticket w-100 btn-lg py-3 fw-bold text-uppercase fs-5 shadow mb-3">
                            <i class="bi bi-plus-circle me-2"></i> Създай Категория
                        </button>

                        <div class="text-center mt-3 border-top border-secondary pt-3">
                            <a asp-action="Index" class="text-decoration-none text-muted fw-bold hover-white">
                                <i class="bi bi-arrow-left me-1"></i> Обратно към списъка
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}