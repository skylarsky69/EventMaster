@model EventMaster.Data.Models.Category


@{
    ViewData["Title"] = "Редактирай Категория";
}

<h1 class="text-center mt-4">Редактирай Категория</h1>

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label fw-bold">Име на категория</label>
                        <input asp-for="Name" class="form-control" placeholder="Въведете ново име..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>
                        <input type="submit" value="Запази промените" class="btn btn-warning" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}