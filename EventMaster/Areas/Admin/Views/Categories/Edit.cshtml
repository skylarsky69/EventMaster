@model EventMaster.Data.Models.Venue

@{
    ViewData["Title"] = "Редактиране на Място";
}

<div class="container mt-5 pt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-black text-white text-center py-4 border-bottom border-secondary">
                    <i class="bi bi-pencil-square text-warning" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mb-0 mt-2 text-uppercase">Редактирай Място</h2>
                </div>

                <div class="card-body p-5 bg-dark text-white">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label text-muted text-uppercase fw-bold small">Име на залата</label>
                            <input asp-for="Name" class="form-control bg-black text-white border-secondary py-2" />
                            <span asp-validation-for="Name" class="text-danger fw-bold"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label text-muted text-uppercase fw-bold small">Адрес</label>
                            <input asp-for="Address" class="form-control bg-black text-white border-secondary py-2" />
                            <span asp-validation-for="Address" class="text-danger fw-bold"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Capacity" class="form-label text-muted text-uppercase fw-bold small">Капацитет</label>
                            <input asp-for="Capacity" class="form-control bg-black text-white border-secondary py-2" />
                            <span asp-validation-for="Capacity" class="text-danger fw-bold"></span>
                        </div>

                        <div class="mt-4 pt-3 border-top border-secondary text-center">
                            <button type="submit" class="btn btn-ticket btn-lg w-100 py-3 text-uppercase fw-black mb-3 shadow text-white">
                                <i class="bi bi-check2-circle me-2"></i> Запази Промените
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-bold text-uppercase rounded-pill mt-2">
                                <i class="bi bi-x-lg me-2"></i> Отказ и връщане
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}