@model EventMaster.Data.Models.Category

@{
    ViewData["Title"] = "Изтриване на Категория";
}

<div class="container mt-5 pt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark border-danger shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4 border-bottom border-danger">
                    <i class="bi bi-exclamation-triangle-fill text-white" style="font-size: 3rem;"></i>
                    <h2 class="fw-bold mb-0 mt-2 text-uppercase">Внимание: Изтриване</h2>
                </div>

                <div class="card-body p-5 bg-dark text-center text-white">
                    <h4 class="mb-4">Сигурни ли сте, че искате да изтриете тази категория?</h4>

                    <div class="bg-black p-4 rounded-3 mb-4 border border-secondary">
                        <span class="d-block text-muted small text-uppercase fw-bold mb-1">Име на категорията:</span>
                        <span class="fs-3 fw-black text-danger">@Model.Name</span>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-danger w-100 btn-lg py-3 fw-bold text-uppercase fs-5 shadow mb-3">
                            <i class="bi bi-trash-fill me-2"></i> Да, Изтрий завинаги
                        </button>

                        <div class="mt-3 border-top border-secondary pt-3">
                            <a asp-action="Index" class="btn btn-outline-light w-100 py-2 fw-bold text-uppercase">
                                <i class="bi bi-x-circle me-1"></i> Отказ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>